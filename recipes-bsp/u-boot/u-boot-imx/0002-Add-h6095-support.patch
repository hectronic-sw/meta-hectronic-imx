+			"TP22_GPA2",
+			"USB1_ID_GPIO",
+			"RESET_GPIO",
+			"EMMC_RESET-",
+			"PCIE1_RST-",
+			"PCIE2_RST-",
+			"USB1_EN_OC-",
+			"HDMI_GPIO6_INT",
+			"USB2_EN_OC-", /* 10 */
+			"MIPI_IRQ",
+			"PCIE_WAKE_R-",
+			"MEM_STRAP0",
+			"MEM_STRAP1",
+			"MEM_STRAP2";
