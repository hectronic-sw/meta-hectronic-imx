+++ b/board/hectronic/h6095/h6095.env
@@ -0,0 +1,28 @@
+boot_targets=mmc0
+initrd_addr=0x93800000
+initrd_high=0xffffffffffffffff
+fdt_addr_r=0x93000000
+fdt_addr=0x93000000
+fdtovaddr=0x93200000
+kernel_addr_r=CONFIG_SYS_LOAD_ADDR
+loadaddr=CONFIG_SYS_LOAD_ADDR
+image=Image
+mmcdev=CONFIG_SYS_MMC_ENV_DEV
+mmcpart=1
+mmcroot=/dev/mmcblk0p2 rootwait rw
+console=ttyLP0,115200
+loadimage=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${image}
+loadfdt=fatload mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${fdtfile}
+bsp_bootcmd=run loadimage; run loadfdt; run loadoverlay; booti ${loadaddr} - ${fdt_addr_r}
+loadoverlays=\
+    if fatload mmc ${mmcdev}:${mmcpart} ${fdtovaddr} overlays.txt; then \
+        env import -t ${fdtovaddr} ${filesize}; \
+        fdt addr ${fdt_addr_r}; \
+        for ov in ${fdt_overlays}; do \
+            fatload mmc ${mmcdev}:${mmcpart} ${fdtovaddr} ${ov}; \
+            fdt resize ${filesize}; \
+            fdt apply ${fdtovaddr}; \
+        done; \
+    fi
+bootargs=console=ttyLP0,115200 root=/dev/mmcblk0p2 rootwait rw
+bsp_bootcmd=run loadimage; run loadfdt; run loadoverlays; booti ${loadaddr} - ${fdt_addr_r}
